# =============================================================================
# scibot — Environment Variables
# Copy this file to .env and fill in the values you need.
# Lines starting with # are comments. All variables are optional unless noted.
# =============================================================================


# =============================================================================
# LLM DEFAULTS
# These control which model get_llm() uses when no config dict is provided.
# =============================================================================

# Provider key: openai | anthropic | google_genai | groq | ollama |
#               mistral | cohere | deepseek | xai | ibm | openrouter | huggingface
DEFAULT_LLM_PROVIDER=google_genai

# Model identifier for the chosen provider (leave blank to use the built-in default)
DEFAULT_LLM_MODEL=

# Sampling temperature  (0.0 – 2.0, default 0.7)
DEFAULT_LLM_TEMPERATURE=0.4

# Maximum tokens in the completion (leave blank for provider default)
DEFAULT_LLM_MAX_TOKENS=


# =============================================================================
# EMBEDDING DEFAULTS
# These control which model get_embedding_model() uses when no config is provided.
# =============================================================================

# Provider key: openai | google_genai | ollama | mistral | cohere | huggingface | ibm
DEFAULT_EMBEDDING_PROVIDER=google_genai

# Model identifier (leave blank to use the built-in default)
DEFAULT_EMBEDDING_MODEL=

# Output vector dimensions — only supported by OpenAI and Google GenAI
DEFAULT_EMBEDDING_DIMENSIONS=768


# =============================================================================
# STORE DEFAULTS
# These control which vector store get_store() targets when no config is provided.
# =============================================================================

# Provider key: chroma | pinecone | qdrant | milvus | mongodb | postgres
DEFAULT_STORE_PROVIDER=chroma

# Collection / index name inside the store
DEFAULT_STORE_COLLECTION=scibot

# Namespace within the collection (Pinecone, Qdrant, MongoDB); leave blank if unused
DEFAULT_STORE_NAMESPACE=


# =============================================================================
# PROVIDER API KEYS
# Only configure the providers you intend to use.
# =============================================================================

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=

# --- Anthropic (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (https://aistudio.google.com/app/apikey) ---
GOOGLE_API_KEY=

# --- Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Mistral AI (https://console.mistral.ai/api-keys) ---
MISTRAL_API_KEY=

# --- Cohere (https://dashboard.cohere.com/api-keys) ---
COHERE_API_KEY=

# --- DeepSeek (https://platform.deepseek.com/api_keys) ---
DEEPSEEK_API_KEY=

# --- xAI / Grok (https://console.x.ai/) ---
XAI_API_KEY=

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=

# --- Hugging Face (https://huggingface.co/settings/tokens) ---
# Required for HuggingFace Inference API; not needed for local sentence-transformers
HUGGINGFACEHUB_API_TOKEN=

# --- IBM watsonx.ai ---
# API key from https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=
# Project ID from your watsonx.ai project settings
IBM_PROJECT_ID=
# Regional endpoint (default: us-south)
IBM_URL=https://us-south.ml.cloud.ibm.com


# =============================================================================
# OLLAMA (local)
# No API key needed. Ollama must be running locally or accessible via the URL below.
# =============================================================================

OLLAMA_BASE_URL=http://localhost:11434


# =============================================================================
# CHROMA STORE
# Chroma can run in-memory (default), on disk, or as a remote HTTP service.
# =============================================================================

# Local persistence directory — leave blank to use in-memory
CHROMA_PERSIST_DIRECTORY=./chroma

# Remote Chroma server — leave blank to use local/in-memory mode
CHROMA_HOST=
CHROMA_PORT=8000


# =============================================================================
# PINECONE STORE (https://app.pinecone.io)
# =============================================================================

PINECONE_API_KEY=

# Name of the Pinecone index to use (REQUIRED when provider=pinecone)
PINECONE_INDEX_NAME=


# =============================================================================
# QDRANT STORE
# Leave QDRANT_URL blank to use in-memory Qdrant (no persistence).
# =============================================================================

# e.g. http://localhost:6333 or https://xyz.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=


# =============================================================================
# MILVUS STORE
# Milvus Lite uses a local file (./milvus.db) by default.
# For a remote Milvus cluster set this to e.g. http://localhost:19530
# =============================================================================

MILVUS_URI=./milvus.db


# =============================================================================
# MONGODB ATLAS STORE (https://cloud.mongodb.com)
# =============================================================================

# Full Atlas connection string, e.g.:
#   mongodb+srv://<user>:<password>@cluster0.abc.mongodb.net/?retryWrites=true
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=scibot


# =============================================================================
# POSTGRESQL (pgvector) STORE
# Requires the pgvector extension installed in your PostgreSQL instance.
# =============================================================================

# libpq connection string, e.g.:
#   postgresql+psycopg://user:password@localhost:5432/scibot
POSTGRES_CONNECTION_STRING=
